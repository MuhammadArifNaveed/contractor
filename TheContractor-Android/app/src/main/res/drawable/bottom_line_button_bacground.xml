<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background of the button (e.g., transparent or a solid color) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" /> <!-- Or a specific background color -->
        </shape>
    </item>
    <!-- Bottom border line -->
    <item android:gravity="bottom">
        <shape>
            <size android:height="2dp" /> <!-- Adjust border thickness as needed -->
            <solid android:color="@color/black" /> <!-- Set your desired border color (e.g., red) -->
        </shape>
    </item>
</layer-list>