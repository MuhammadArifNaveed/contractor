<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="10dp"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/search_bacground"
    android:layout_marginHorizontal="10dp"
    android:layout_marginTop="5dp">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/are_you_sure_to_buy_this_membership"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:gravity="center"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/haveCoupon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/have_coupon"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:background="@drawable/green_button_bacground"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"/>


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/buy_using_card"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:background="@drawable/button_bacground"
            android:layout_weight="1"
            android:layout_marginStart="5dp"/>


    </LinearLayout>



</LinearLayout>