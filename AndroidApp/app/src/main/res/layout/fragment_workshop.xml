<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Fragments.WorkshopFragment"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screenPadding"
        android:id="@+id/requestForQuotationLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/workshop"
                    style="@style/headingStyle" />

                <View
                    android:layout_width="@dimen/headingLineWidth"
                    android:layout_height="@dimen/headingLineHeight"
                    android:background="@drawable/heading_line_bacground"/>

            </LinearLayout>


        </LinearLayout>


        <Spinner
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.AppCompat.Spinner"
            android:background="@drawable/spinner_background"
            android:dropDownVerticalOffset="?attr/dropdownListPreferredItemHeight"
            android:id="@+id/workshopTypeSpinner"
            android:spinnerMode="dropdown"
            android:layout_marginTop="10dp" />


        <Spinner
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.AppCompat.Spinner"
            android:background="@drawable/spinner_background"
            android:dropDownVerticalOffset="?attr/dropdownListPreferredItemHeight"
            android:id="@+id/workshopSectorSpinner"
            android:spinnerMode="dropdown"
            android:layout_marginTop="10dp" />


        <Spinner
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.AppCompat.Spinner"
            android:background="@drawable/spinner_background"
            android:dropDownVerticalOffset="?attr/dropdownListPreferredItemHeight"
            android:id="@+id/workshopCitySpinner"
            android:spinnerMode="dropdown"
            android:layout_marginTop="10dp" />


        <EditText
            android:id="@+id/titleET"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/title"
            android:inputType="textCapSentences"
            style="@style/editTextStyle"
            android:layout_marginTop="10dp"/>


        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/description"
            android:gravity="top"
            android:id="@+id/detailsET"
            android:inputType="textMultiLine"
            android:lines="8"
            style="@style/editTextStyle"
            android:maxLines="10"
            android:minLines="3"
            android:scrollbars="vertical"
            android:layout_marginTop="10dp" />




        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/chooseImages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/choose_images"
            android:background="@drawable/edittext_background"
            android:textColor="@color/editTextColor"
            android:textSize="@dimen/editTextSize"
            android:textAllCaps="false"
            android:gravity="center"/>



        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/maximum_5_images"
            android:textSize="12sp"
            android:textColor="@color/black" />



        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/customImagesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/config_container"
            android:layout_marginTop="10dp"
            android:visibility="gone"/>



        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/updateProfileBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/post"
            style="@style/buttonStyle"/>

    </LinearLayout>



</androidx.core.widget.NestedScrollView>