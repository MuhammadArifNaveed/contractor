<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Fragments.CompanyDetailFragment"
    android:padding="@dimen/screenPadding"
    android:background="@color/background"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/descriptionLayout">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/description"
                    style="@style/headingStyle"/>

                <View
                    android:layout_width="@dimen/headingLineWidth"
                    android:layout_height="@dimen/headingLineHeight"
                    android:background="@drawable/heading_line_bacground"/>


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:textSize="14sp"
                    android:id="@+id/companyDescriptionTV"
                    android:layout_marginTop="2dp"/>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.1dp"
                    android:background="@color/lightColor"
                    android:layout_marginVertical="10dp"/>

            </LinearLayout>





            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/addressLayout">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/address"
                    style="@style/headingStyle" />

                <View
                    android:layout_width="@dimen/headingLineWidth"
                    android:layout_height="@dimen/headingLineHeight"
                    android:background="@drawable/heading_line_bacground"/>


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Address"
                    android:textSize="14sp"
                    android:id="@+id/companyAddressTV"
                    android:layout_marginTop="2dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.1dp"
                    android:background="@color/lightColor"
                    android:layout_marginVertical="10dp"/>


            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/cityLayout"
                    android:layout_weight="1">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/city"
                        style="@style/headingStyle" />

                    <View
                        android:layout_width="@dimen/headingLineWidth"
                        android:layout_height="@dimen/headingLineHeight"
                        android:background="@drawable/heading_line_bacground"/>


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="City"
                        android:textSize="14sp"
                        android:id="@+id/companyCityTV"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/areaLayout"
                    android:layout_weight="1">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/area"
                        style="@style/headingStyle" />

                    <View
                        android:layout_width="@dimen/headingLineWidth"
                        android:layout_height="@dimen/headingLineHeight"
                        android:background="@drawable/heading_line_bacground"/>


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Area"
                        android:textSize="14sp"
                        android:id="@+id/companyAreaTV"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>




            </LinearLayout>


            <View
                android:layout_width="match_parent"
                android:layout_height="0.1dp"
                android:background="@color/lightColor"
                android:layout_marginVertical="10dp"/>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/sinceLayout"
                    android:layout_weight="1">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/since"
                        style="@style/headingStyle" />

                    <View
                        android:layout_width="@dimen/headingLineWidth"
                        android:layout_height="@dimen/headingLineHeight"
                        android:background="@drawable/heading_line_bacground"/>


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="since"
                        android:textSize="14sp"
                        android:id="@+id/companySinceTV"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/noOfEmployeesLayout"
                    android:layout_weight="1">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/noOFEmployees"
                        style="@style/headingStyle" />

                    <View
                        android:layout_width="@dimen/headingLineWidth"
                        android:layout_height="@dimen/headingLineHeight"
                        android:background="@drawable/heading_line_bacground"/>


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="no of employee"
                        android:textSize="14sp"
                        android:id="@+id/companyNoOfEmployeesTV"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>




            </LinearLayout>


            <View
                android:layout_width="match_parent"
                android:layout_height="0.1dp"
                android:background="@color/lightColor"
                android:layout_marginVertical="10dp"/>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/subCategoryLayout"
                android:layout_weight="1">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sub_categories"
                    style="@style/headingStyle" />

                <View
                    android:layout_width="@dimen/headingLineWidth"
                    android:layout_height="@dimen/headingLineHeight"
                    android:background="@drawable/heading_line_bacground"/>


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/subCategoriesRV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"/>

            </LinearLayout>




        </LinearLayout>

    </androidx.core.widget.NestedScrollView>



</LinearLayout>